<Window x:Class="StudioCameraViewer.MultiCameraOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Camera Output" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        Topmost="True" 
        Background="Black"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid x:Name="MainGrid">
        <!-- Dynamically sized grid for cameras -->
        <Grid x:Name="CameraGrid" Background="Black"/>

        <!-- Status Overlay -->
        <TextBlock x:Name="TxtStatusOverlay" 
                   Text="Waiting for cameras..." 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Opacity="0.7"/>
    </Grid>
</Window>
