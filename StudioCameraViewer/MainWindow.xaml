<Window x:Class="StudioCameraViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Studio Camera Viewer" Height="800" Width="980"
        Background="#F5F5F7">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- Buttons placed first in XAML to dock correctly to the far right -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="BtnOpenBothOverhead" Content="Launch Both Overhead" 
                Height="36" Padding="14,0" Margin="0,0,10,0" 
                Background="#0066CC" Foreground="White" FontWeight="SemiBold"
                Click="BtnOpenBothOverhead_Click"/>
                <Button x:Name="BtnOpenMulticam" Content="Open Multicam Window" 
                Height="36" Padding="14,0" 
                Click="BtnOpenMulticam_Click"/>
            </StackPanel>

            <!-- Title fills the remaining space on the left -->
            <TextBlock Text="Studio Camera Routing &amp; Control" 
               FontSize="22" FontWeight="Bold" Foreground="#1D1D1F" 
               VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>

                <!-- SECTION 1: OVERHEAD MONITORS -->
                <TextBlock Text="Overhead Monitor Routing" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MONITOR A CARD -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E5EA" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="MONITOR A (LEFT)" FontWeight="Bold" FontSize="12" Foreground="#0066CC" VerticalAlignment="Center"/>
                                <Button Content="Launch Monitor A" Height="26" Padding="10,0" HorizontalAlignment="Right" Click="BtnOpenOverheadA_Click"/>
                            </DockPanel>

                            <TextBlock Text="Target Display:" FontSize="12" FontWeight="SemiBold" Foreground="#6E6E73" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboDisplayA" Height="34" Padding="8,4" Margin="0,0,0,12"/>

                            <TextBlock Text="Camera Stream:" FontSize="12" FontWeight="SemiBold" Foreground="#6E6E73" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboStreamA" Height="34" Padding="8,4"/>
                        </StackPanel>
                    </Border>

                    <!-- MONITOR B CARD -->
                    <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E5EA" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="MONITOR B (RIGHT)" FontWeight="Bold" FontSize="12" Foreground="#0066CC" VerticalAlignment="Center"/>
                                <Button Content="Launch Monitor B" Height="26" Padding="10,0" HorizontalAlignment="Right" Click="BtnOpenOverheadB_Click"/>
                            </DockPanel>

                            <TextBlock Text="Target Display:" FontSize="12" FontWeight="SemiBold" Foreground="#6E6E73" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboDisplayB" Height="34" Padding="8,4" Margin="0,0,0,12"/>

                            <TextBlock Text="Camera Stream:" FontSize="12" FontWeight="SemiBold" Foreground="#6E6E73" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboStreamB" Height="34" Padding="8,4"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SECTION 2: MULTICAM GRID CONFIGURATION -->
                <TextBlock Text="Multicam Matrix Config" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,10"/>

                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E5EA" BorderThickness="1" Padding="18" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- MultiCam Target Monitor & Preset Config -->
                        <Grid Margin="8,0,8,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Target Display:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6E6E73" FontSize="12"/>
                            <ComboBox x:Name="ComboMultiCamDisplay" Grid.Column="1" Height="34" Padding="8,4" Margin="0,0,16,0"/>

                            <TextBlock Text="Layout Preset:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6E6E73" FontSize="12"/>
                            <ComboBox x:Name="ComboMultiCamPreset" Grid.Column="3" Height="34" Padding="8,4" SelectionChanged="ComboMultiCamPreset_SelectionChanged">
                                <ComboBoxItem Content="4-Camera Grid (2x2)" IsSelected="True"/>
                                <ComboBoxItem Content="2-Camera Side-by-Side (Full 1080p)"/>
                                <ComboBoxItem Content="Single Camera Focus"/>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="0,4,0,12" Background="#E5E5EA"/>

                        <UniformGrid x:Name="GridMultiCamLayout" Columns="2" Rows="2">
                            <StackPanel x:Name="BoxQuad1" Margin="8">
                                <TextBlock Text="QUAD 1 (TOP LEFT)" FontSize="11" FontWeight="Bold" Foreground="#0066CC" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ComboMultiCam1" Height="34"/>
                            </StackPanel>
                            <StackPanel x:Name="BoxQuad2" Margin="8">
                                <TextBlock Text="QUAD 2 (TOP RIGHT)" FontSize="11" FontWeight="Bold" Foreground="#0066CC" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ComboMultiCam2" Height="34"/>
                            </StackPanel>
                            <StackPanel x:Name="BoxQuad3" Margin="8">
                                <TextBlock Text="QUAD 3 (BOTTOM LEFT)" FontSize="11" FontWeight="Bold" Foreground="#0066CC" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ComboMultiCam3" Height="34"/>
                            </StackPanel>
                            <StackPanel x:Name="BoxQuad4" Margin="8">
                                <TextBlock Text="QUAD 4 (BOTTOM RIGHT)" FontSize="11" FontWeight="Bold" Foreground="#0066CC" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ComboMultiCam4" Height="34"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <DockPanel Grid.Row="2">
            <Button x:Name="BtnRefreshFeeds" Content="Refresh NDI Feeds &amp; Monitors" Height="34" Padding="12,0" Click="BtnRefreshFeeds_Click"/>
        </DockPanel>
    </Grid>
</Window>