<Window x:Class="StudioCameraViewer.MultiCamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multicam Viewer" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Background="Black"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Main Layout Container referenced in C# code-behind -->
        <UniformGrid x:Name="MainMultiCamGrid" Columns="2" Rows="2">

            <!-- QUAD / CAMERA 1 -->
            <Border x:Name="Quad1Frame" Background="#111111" Margin="2" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Image x:Name="Feed1Image" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LabelCam1" Text="Cam 1" Foreground="White" FontSize="14" FontWeight="Bold" 
                               Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#88000000" Padding="6,2"/>
                </Grid>
            </Border>

            <!-- QUAD / CAMERA 2 -->
            <Border x:Name="Quad2Frame" Background="#111111" Margin="2" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Image x:Name="Feed2Image" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LabelCam2" Text="Cam 2" Foreground="White" FontSize="14" FontWeight="Bold" 
                               Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#88000000" Padding="6,2"/>
                </Grid>
            </Border>

            <!-- QUAD / CAMERA 3 -->
            <Border x:Name="Quad3Frame" Background="#111111" Margin="2" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Image x:Name="Feed3Image" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LabelCam3" Text="Cam 3" Foreground="White" FontSize="14" FontWeight="Bold" 
                               Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#88000000" Padding="6,2"/>
                </Grid>
            </Border>

            <!-- QUAD / CAMERA 4 -->
            <Border x:Name="Quad4Frame" Background="#111111" Margin="2" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Image x:Name="Feed4Image" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LabelCam4" Text="Cam 4" Foreground="White" FontSize="14" FontWeight="Bold" 
                               Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#88000000" Padding="6,2"/>
                </Grid>
            </Border>

        </UniformGrid>

        <!-- On-Screen Notification Overlay -->
        <TextBlock x:Name="OverlayInfoText" 
                   Text="Press ESC to return to Control Panel" 
                   Foreground="White" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Background="#AA000000" 
                   Padding="16,8"/>
    </Grid>
</Window>