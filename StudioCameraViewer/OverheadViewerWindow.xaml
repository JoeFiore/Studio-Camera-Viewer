<Window x:Class="StudioCameraViewer.OverheadViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overhead Camera Feed" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        Topmost="True" 
        Background="Black"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid>
        <Image x:Name="ImgVideoFrame" Stretch="Uniform"/>
        <TextBlock x:Name="TxtStatus" 
                   Text="Waiting for vMix NDI Feed..." 
                   Foreground="White" 
                   FontSize="22" 
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   TextAlignment="Center"/>
    </Grid>
</Window>