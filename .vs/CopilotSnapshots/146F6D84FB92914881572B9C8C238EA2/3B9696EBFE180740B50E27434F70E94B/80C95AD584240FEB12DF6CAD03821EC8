<Window x:Class="StudioCameraViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="On The Prowl - Studio Control Panel" Height="520" Width="720"
        WindowStartupLocation="CenterScreen" Background="#121212"
        ResizeMode="CanMinimize"
        Icon="app.ico">
    
    <Window.Resources>
        <!-- Modern Button Style with Proper Breathing Room -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Accent Action Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled ComboBox with high-contrast text -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E4E4E7"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <!-- ComboBox Item Text Color -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ON THE PROWL BROADCAST STUDIO" FontSize="11" FontWeight="Bold" Foreground="#007ACC"/>
            <TextBlock Text="Overhead Monitor Routing" FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="14,8" Margin="0,0,6,12" CornerRadius="6" Background="#1E1E22" BorderBrush="#2D2D30" BorderThickness="1">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#A1A1AA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Dashboard Tab -->
            <TabItem Header="Monitor Dashboard">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Routing Cards Grid -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Overhead Card -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="MONITOR A (LEFT)" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                <TextBlock Text="Target Display" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbDisplay1" Margin="0,0,0,16"/>

                                <TextBlock Text="vMix Camera Stream" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbCamera1"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Overhead Card -->
                        <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="MONITOR B (RIGHT)" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                                <TextBlock Text="Target Display" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbDisplay2" Margin="0,0,0,16"/>

                                <TextBlock Text="vMix Camera Stream" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbCamera2"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Warning Banner -->
                    <Border x:Name="BannerWarning" Grid.Row="1" Background="#2C1517" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtWarning" Text="Warning: No active vMix NDI feeds detected on this PC." Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action Bar -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BtnRefresh" Content="Refresh Feeds" Style="{StaticResource ModernButton}" Margin="0,0,14,0" Click="BtnRefresh_Click"/>
                            <Button x:Name="BtnSaveDefaults" Content="Save Preset" Style="{StaticResource ModernButton}" Click="BtnSaveDefaults_Click"/>
                        </StackPanel>

                        <Button x:Name="BtnStart" Content="Launch Overheads" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Width="170" Click="BtnStart_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Troubleshooting Tab -->
            <TabItem Header="Camera Setup Guide">
                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="DeckLink Hardware Lock &amp; NDI Routing" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                            <TextBlock Text="The Blackmagic DeckLink card is locked exclusively by vMix. To pass the camera feeds to this app without extra hardware, vMix routes them over local network memory using NDI." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="To Enable Camera Streams in vMix:" FontSize="13" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,8"/>
                            <TextBlock Text="1. Open vMix Pro." Foreground="#E4E4E7" Margin="0,2"/>
                            <TextBlock Text="2. Click Settings in the top-right corner." Foreground="#E4E4E7" Margin="0,2"/>
                            <TextBlock Text="3. Select Outputs / NDI / SRT from the left sidebar." Foreground="#E4E4E7" Margin="0,2"/>
                            <TextBlock Text="4. Check 'Cameras / Calls / Audio Inputs' near the bottom." Foreground="#E4E4E7" Margin="0,2"/>
                            <TextBlock Text="5. Click OK and hit 'Refresh Feeds' on the Dashboard tab." Foreground="#E4E4E7" Margin="0,2"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>