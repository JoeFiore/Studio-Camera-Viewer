<Window x:Class="StudioCameraViewer.MultiCameraOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Camera Output" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        Topmost="True" 
        Background="Black"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid>
        <!-- 2x2 Grid Layout (4 Cameras) -->
        <Grid x:Name="GridLayout4" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Camera 1 - Top Left -->
            <Border Grid.Row="0" Grid.Column="0" Background="Black" BorderBrush="#333" BorderThickness="2">
                <Grid>
                    <Image x:Name="ImgCamera1" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtCamera1" Foreground="White" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Camera 2 - Top Right -->
            <Border Grid.Row="0" Grid.Column="1" Background="Black" BorderBrush="#333" BorderThickness="2">
                <Grid>
                    <Image x:Name="ImgCamera2" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtCamera2" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Camera 3 - Bottom Left -->
            <Border Grid.Row="1" Grid.Column="0" Background="Black" BorderBrush="#333" BorderThickness="2">
                <Grid>
                    <Image x:Name="ImgCamera3" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtCamera3" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Camera 4 - Bottom Right -->
            <Border Grid.Row="1" Grid.Column="1" Background="Black" BorderBrush="#333" BorderThickness="2">
                <Grid>
                    <Image x:Name="ImgCamera4" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtCamera4" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 2x1 Grid Layout (2 Cameras - Side by Side) -->
        <Grid x:Name="GridLayout2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Camera 1 - Left -->
            <Border Grid.Column="0" Background="Black" BorderBrush="#333" BorderThickness="2">
                <Grid>
                    <Image x:Name="ImgCamera1_2View" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtCamera1_2View" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Camera 2 - Right -->
            <Border Grid.Column="1" Background="Black" BorderBrush="#333" BorderThickness="2">
                <Grid>
                    <Image x:Name="ImgCamera2_2View" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtCamera2_2View" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Overlay -->
        <TextBlock x:Name="TxtStatusOverlay" 
                   Text="Waiting for cameras..." 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Opacity="0.7"/>
    </Grid>
</Window>
